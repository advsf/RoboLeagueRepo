  - m_Id: 805157519020042
    m_Localized: "Beraberlikte XP kazan\u0131lmaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 805157519020043
    m_Localized: "Yeterince oynamad\u0131\u011F\u0131n i\xE7in XP kazanamad\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 805157519020044
    m_Localized: "{username} ba\u011Fland\u0131"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 805157519020045
    m_Localized: "{username} ba\u011Flant\u0131y\u0131 kesti"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1115665900032000
    m_Localized: "{username}, {team} tak\u0131m\u0131na {position} olarak kat\u0131ld\u0131"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1115665912614912
    m_Localized: "{username} oyundan at\u0131ld\u0131"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1118737883779072
    m_Localized: "TOP VURU\u015EU \xC7ARPANI"
    m_Metadata:
      m_Items: []
  - m_Id: 1118737942499328
    m_Localized: "TOP E\u011ER\u0130 \xC7ARPAN"
    m_Metadata:
      m_Items: []
  - m_Id: 1118737942499329
    m_Localized: "OYUNCU HIZI \xC7ARPANI"
    m_Metadata:
      m_Items: []
  - m_Id: 1125934067929088
    m_Localized: "Hi\xE7biri"
    m_Metadata:
      m_Items: []
  - m_Id: 1125934130843648
    m_Localized: "Sapt\u0131rma"
    m_Metadata:
      m_Items: []
  - m_Id: 1126491130220544
    m_Localized: "Bitiri\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 1125934130843650
    m_Localized: "G\xFC\xE7l\xFC \u015Fut"
    m_Metadata:
      m_Items: []
  - m_Id: 1125934130843651
    m_Localized: Rulet
    m_Metadata:
      m_Items: []
  - m_Id: 1125934130843652
    m_Localized: "H\u0131zl\u0131 oyuncu"
    m_Metadata:
      m_Items: []
  - m_Id: 1125934130843653
    m_Localized: "Top kontrol\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409600
    m_Localized: HEDEFLER
    m_Metadata:
      m_Items: []
  - m_Id: 1146423297495040
    m_Localized: "G\xD6STERMEK \u0130\xC7\u0130N TIKLAYIN"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512789381121
    m_Localized: "KALEC\u0130LER\u0130 VURAMAZSIN!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512789381122
    m_Localized: "HIZ ARTI\u015EI!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512789381123
    m_Localized: "OYUN BA\u015ELAMADAN \xD6NCE BU YETENE\u011E\u0130 KULLANAMAZSINIZ!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512789381124
    m_Localized: "TAKIM ARKADA\u015EIMIN TOPUNU YAKALAYAMIYORUM!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575424
    m_Localized: "KEND\u0130 ATI\u015EINIZI SAPTIRAMAZSINIZ!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575425
    m_Localized: "GOL VURU\u015ELARINI Y\xD6NLEND\u0130REMEZ!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575426
    m_Localized: "AL\xC7AK TOPLARI FERAGAT EDEMEZS\u0130N\u0130Z!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575427
    m_Localized: "\xC7OK FAZLA!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575428
    m_Localized: YERDE OLMALISINIZ!
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575429
    m_Localized: "\u015EU AN RULET OYNAYAMIYORUM!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575430
    m_Localized: "SON VURU\u015EU SEN YAPMALISIN!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575431
    m_Localized: "MENZ\u0130LDE!"
    m_Metadata:
      m_Items: []
  - m_Id: 1133512793575432
    m_Localized: "\u015EU AN TUZAK KURAMIYORUM!"
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409601
    m_Localized: YARDIMCI OLUR
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409602
    m_Localized: TASARRUF
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409603
    m_Localized: KONUM
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409604
    m_Localized: PING
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409605
    m_Localized: "G\xD6NDERMEK"
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409606
    m_Localized: "SUNUCU SENKRON\u0130ZASYON BOZUKLU\u011EU"
    m_Metadata:
      m_Items: []
  - m_Id: 1146423360409607
    m_Localized: "Y\xDCKSEK GEC\u0130KME S\xDCRES\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1155336189300736
    m_Localized: "OLU\u015ETURMA AYARLARI"
    m_Metadata:
      m_Items: []
  - m_Id: 1155336189300737
    m_Localized: SIFIRLAMA TOPU
    m_Metadata:
      m_Items: []
  - m_Id: 1155336189300738
    m_Localized: "D\xDC\u015E\xDCK TEKL\u0130F VERME"
    m_Metadata:
      m_Items: []
  - m_Id: 1155336189300739
    m_Localized: SPAWN HIGH BALL
    m_Metadata:
      m_Items: []
  - m_Id: 1155336189300740
    m_Localized: SPAWN MUMMY
    m_Metadata:
      m_Items: []
  - m_Id: 1155336189300741
    m_Localized: "SAHTE HESABINI S\u0130L"
    m_Metadata:
      m_Items: []
  - m_Id: 1155336189300742
    m_Localized: "GK'y\u0131 ETK\u0130NLE\u015ET\u0130R/DEVRE DI\u015EI BIRAK"
    m_Metadata:
      m_Items: []
  - m_Id: 1156324417654784
    m_Localized: "MET\u0130N G\u0130R\u0130N..."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875371048960
    m_Localized: "Bu e\u011Fitime ho\u015F geldiniz! \u0130lk a\u015Famada, hareketin
      temellerini \xF6\u011Freneceksiniz. Hareket etmek i\xE7in WASD tu\u015Flar\u0131n\u0131,
      ko\u015Fmak i\xE7in sol Shift tu\u015Funu, z\u0131plamak i\xE7in bo\u015Fluk
      tu\u015Funu, kaymak i\xE7in sol Control tu\u015Funu ve h\u0131zl\u0131 ko\u015Fmak
      i\xE7in E tu\u015Funu kullan\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574912
    m_Localized: "Sol kontrol tu\u015Funa basarak topa do\u011Fru kayarak g\xFC\xE7
      katabilirsiniz. Bu, rakiplerden topu almak veya al\xE7ak \u015Futlar\u0131
      savu\u015Fturmak i\xE7in kullan\u0131\u015Fl\u0131d\u0131r. \u015Eimdi, topu
      bariyerin i\xE7ine kayd\u0131r\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574913
    m_Localized: "Sonraki ad\u0131mda, top s\xFCrmeyi \xF6\u011Freneceksiniz. Top
      s\xFCrme hareketini ba\u015Flatmak i\xE7in sa\u011F fare d\xFC\u011Fmesini
      kullan\u0131n; bu, topun oyuncunuzun y\xF6n\xFCn\xFC takip etmesini sa\u011Flayacakt\u0131r.
      Savunmalar\u0131 a\u015Fmak i\xE7in kullan\u0131\u015Fl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574914
    m_Localized: "\u015Eimdi nas\u0131l \u015Fut \xE7ekece\u011Finizi \xF6\u011Freneceksiniz.
      \u015Eut \xE7ekmek i\xE7in sol fare d\xFC\u011Fmesini bas\u0131l\u0131 tutun.
      Topa vurmadan \xF6nce yukar\u0131 bakarak topun y\xFCksekli\u011Fini art\u0131rabilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574915
    m_Localized: "Art\u0131k nas\u0131l vuru\u015F yapaca\u011F\u0131n\u0131z\u0131
      bildi\u011Finize g\xF6re, topa nas\u0131l falso verece\u011Finizi de \xF6\u011Freneceksiniz.
      Topa falso vermek i\xE7in \u015Fut atmadan \xF6nce fareyle hafif\xE7e vurun.
      Falsolu \u015Futlar, falsosuz \u015Futlardan daha h\u0131zl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574916
    m_Localized: "Her pozisyonun (orta saha pozisyonlar\u0131 hari\xE7) iki benzersiz
      yetene\u011Fi vard\u0131r. Santrafordan ba\u015Flayarak, g\xFC\xE7l\xFC \u015Fut
      yetene\u011Fi, \u015Fut \xE7ubu\u011Funu do\u011Fru zamanlamayla kulland\u0131\u011F\u0131n\u0131z
      takdirde daha g\xFC\xE7l\xFC \u015Fut atman\u0131z\u0131 sa\u011Flar. M\xFCkemmel
      bir zamanlama i\xE7in, \xE7ubuk beyaz k\u0131sma de\u011Fdi\u011Fi anda b\u0131rakmal\u0131s\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574917
    m_Localized: "CF'nin bir sonraki yetene\u011Fi olan \"h\u0131zc\u0131\", k\u0131sa
      bir s\xFCreli\u011Fine daha h\u0131zl\u0131 hareket etmenizi sa\u011Flar. Bu,
      savunmalar\u0131 h\u0131zla ge\xE7erek oyun kurmak i\xE7in kullan\u0131labilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574918
    m_Localized: "Orta saha oyuncusu (sol/sa\u011F orta saha) olarak, topu \"tuzaklama\"
      veya topun h\u0131z\u0131n\u0131 tamamen durdurma yetene\u011Fine sahip olacaks\u0131n\u0131z.
      Bunu kullanmak i\xE7in topa yakla\u015Fmal\u0131 ve yetene\u011Fi kullanmal\u0131s\u0131n\u0131z.
      Y\xFCksek paslar\u0131 veya h\u0131zl\u0131 hareket eden toplar\u0131 yakalamak
      i\xE7in kullan\u0131\u015Fl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574919
    m_Localized: "Orta saha oyuncusu olarak bir sonraki yetene\u011Finiz, topu oyuncunuzla
      birlikte s\xFCr\xFCkledi\u011Finiz bir rulet hareketi veya d\xF6n\xFC\u015F
      hareketi yapman\u0131za olanak tan\u0131r. Bu hareketi yapmak size hafif bir
      h\u0131z art\u0131\u015F\u0131 da sa\u011Flar. Bunu kullanmak i\xE7in son vuru\u015Fu
      yapan ki\u015Fi olmal\u0131 ve topa yeterince yak\u0131n olmal\u0131s\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574920
    m_Localized: "Bir defans oyuncusu (CB) olarak, iki savunma hamlesine eri\u015Fiminiz
      var. Birincisi \"\xF6ld\xFCrme\" olarak adland\u0131r\u0131l\u0131yor ve bunu
      kullanmak i\xE7in bir oyuncuyu ge\xE7ici olarak sersemletmek \xFCzere hedef
      alman\u0131z gerekiyor. Bu, sald\u0131r\u0131lar\u0131 durdurmada son derece
      etkili olabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574921
    m_Localized: "Bir sonraki savunma yetene\u011Finiz \"sapt\u0131rma\" olarak adland\u0131r\u0131l\u0131yor
      ve havadaki toplar\u0131 sapt\u0131rman\u0131za olanak tan\u0131yor. Bu \xF6zellik,
      y\xFCksek paslar\u0131 veya \u015Futlar\u0131 engellemek i\xE7in kullan\u0131labilir.
      \u0130yi kullan\u0131ld\u0131\u011F\u0131nda ger\xE7ekten g\xFC\xE7l\xFC bir
      \xF6zellik."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574922
    m_Localized: "Kaleci olarak herhangi bir yetene\u011Finiz olmayacak. Ancak, topa
      temas etti\u011Finde dal\u0131\u015F yapabilir ve topu savu\u015Fturabilirsiniz.
      Oyuncunuzun hareket etti\u011Fi y\xF6ne do\u011Fru dal\u0131\u015F yapmak i\xE7in
      Q tu\u015Funa bas\u0131n ve havay\u0131 kapatmak i\xE7in dal\u0131\u015Ftan
      \xF6nce z\u0131play\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574923
    m_Localized: "Yerdeyken de topu yakalamak i\xE7in T tu\u015Funa basabilirsiniz.
      Topu ger\xE7ekten yakalayabilmek i\xE7in topun \xFCzerinde oldu\u011Funuzdan
      emin olmal\u0131s\u0131n\u0131z. Sald\u0131r\u0131lar\u0131 tamamen durdurmak
      i\xE7in kullan\u0131\u015Fl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574924
    m_Localized: "Top elinize ge\xE7ti\u011Finde iki se\xE7ene\u011Finiz var: topu
      yere vurarak pas vermek veya topu yuvarlayarak pas vermek. Yere vurarak pas
      vermek i\xE7in, normal bir vuru\u015Fta oldu\u011Fu gibi sol fare d\xFC\u011Fmesini
      kullanarak pas\u0131n\u0131z\u0131 \u015Farj etmeniz gerekir. Yere vurarak
      paslar, yuvarlayarak yap\u0131lan paslardan daha uza\u011Fa ve daha y\xFCkse\u011Fe
      gidebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574925
    m_Localized: "Yuvarlama pas\u0131 yapmak i\xE7in topun elinizde olmas\u0131 gerekir.
      Ard\u0131ndan, yuvarlama pas\u0131 i\xE7in haz\u0131rl\u0131k yapmak \xFCzere
      sa\u011F fare d\xFC\u011Fmesini (top s\xFCrme ile ayn\u0131 \u015Fekilde) bas\u0131l\u0131
      tutun, sonra topu b\u0131rakmak i\xE7in d\xFC\u011Fmeyi b\u0131rak\u0131n.
      Bu, k\u0131sa ama daha kontroll\xFC bir pas ger\xE7ekle\u015Ftirecektir."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574926
    m_Localized: "E\u011Fitimi ba\u015Far\u0131yla tamamlad\u0131\u011F\u0131n\u0131z
      i\xE7in tebrikler! Art\u0131k temel bilgileri \xF6\u011Frendi\u011Finize g\xF6re,
      di\u011Fer oyuncularla tam bir \xE7evrimi\xE7i ma\xE7 oynayabilir veya bir
      antrenman sunucusuna kat\u0131larak becerilerinizi geli\u015Ftirmeye devam
      edebilirsiniz. Bu e\u011Fitimde ele al\u0131nmayan daha bir\xE7ok gizli teknik
      ve harika \u015Fey var. \u0130yi \u015Fanslar ve iyi e\u011Flenceler!"
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769216
    m_Localized: "Bu e\u011Fitime ho\u015F geldiniz! \u0130lk a\u015Famada, hareketin
      temellerini \xF6\u011Freneceksiniz. Y\xFCr\xFCmek i\xE7in sol joystick'i kullan\u0131n
      ve ko\u015Fmak i\xE7in daha da ileriye itin. Sa\u011F tarafta ise z\u0131plamak,
      kaymak ve depar atmak i\xE7in \xFC\xE7 d\xFC\u011Fmeye t\u0131klayabilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769217
    m_Localized: "Kayd\u0131rma d\xFC\u011Fmesine basarak topa do\u011Fru kayarak
      topa daha fazla g\xFC\xE7 katabilirsiniz. Bu, rakiplerden topu almak veya al\xE7aktan
      gelen \u015Futlar\u0131 savu\u015Fturmak i\xE7in kullan\u0131\u015Fl\u0131d\u0131r.
      \u015Eimdi, topu bariyerin i\xE7ine kayd\u0131r\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769218
    m_Localized: "Sonraki ad\u0131mda, top s\xFCrmeyi \xF6\u011Freneceksiniz. Top
      s\xFCrme hareketini ba\u015Flatmak i\xE7in sa\u011F joystick'i \"D\" d\xFC\u011Fmesiyle
      birlikte kullan\u0131n ve bas\u0131l\u0131 tutun. Joystick'in y\xF6n\xFCne
      ba\u011Fl\u0131 olarak, top o y\xF6ne do\u011Fru hareket edecektir. Savunmalar\u0131
      a\u015Fmak i\xE7in kullan\u0131\u015Fl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769219
    m_Localized: "\u015Eimdi nas\u0131l \xE7ekim yapaca\u011F\u0131n\u0131z\u0131
      \xF6\u011Freneceksiniz. Vuru\u015F yapmak i\xE7in joystick'i \"S\" d\xFC\u011Fmesiyle
      birlikte bas\u0131l\u0131 tutun. Vuru\u015F yapmadan \xF6nce kameray\u0131
      yukar\u0131 hareket ettirerek y\xFCksekli\u011Fi ayarlayabilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769220
    m_Localized: "Art\u0131k nas\u0131l vuru\u015F yapaca\u011F\u0131n\u0131z\u0131
      bildi\u011Finize g\xF6re, topa nas\u0131l falso verece\u011Finizi de \xF6\u011Freneceksiniz.
      T\u0131pk\u0131 top s\xFCrme gibi, joystick'in y\xF6n\xFC falsonun y\xF6n\xFCn\xFC
      belirleyecektir. Ayr\u0131ca, falsolu vuru\u015Flar falsosuz vuru\u015Flardan
      daha h\u0131zl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769221
    m_Localized: "Her pozisyonun iki benzersiz yetene\u011Fi vard\u0131r. CF'den
      ba\u015Flayarak, Powerkick yetene\u011Fi, \u015Fut \xE7ubu\u011Funu do\u011Fru
      zamanlamayla kulland\u0131\u011F\u0131n\u0131z takdirde daha g\xFC\xE7l\xFC
      \u015Fut atman\u0131z\u0131 sa\u011Flar. M\xFCkemmel bir zamanlama i\xE7in,
      \xE7ubuk beyaz k\u0131sma de\u011Fdi\u011Fi anda b\u0131rakmal\u0131s\u0131n\u0131z.
      Bunu \"L\" d\xFC\u011Fmesine iki kez basarak etkinle\u015Ftirebilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769222
    m_Localized: "CF'nin bir sonraki yetene\u011Fi olan \"h\u0131zl\u0131 ko\u015Fucu\",
      k\u0131sa bir s\xFCre i\xE7in daha h\u0131zl\u0131 hareket etmenizi sa\u011Flar.
      Bu, savunmalar\u0131 h\u0131zla ge\xE7erek oyun kurmak i\xE7in kullan\u0131labilir.
      \"R\" tu\u015Funa iki kez basarak etkinle\u015Ftirebilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769223
    m_Localized: "Orta saha oyuncusu (sol/sa\u011F orta saha) olarak, topu \"tuzaklama\"
      veya topun h\u0131z\u0131n\u0131 tamamen durdurma yetene\u011Fine sahip olacaks\u0131n\u0131z.
      Bunu kullanmak i\xE7in topa yakla\u015Fmal\u0131 ve yetene\u011Fi kullanmal\u0131s\u0131n\u0131z.
      Y\xFCksek paslar\u0131 veya h\u0131zl\u0131 hareket eden toplar\u0131 yakalamak
      i\xE7in kullan\u0131\u015Fl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769224
    m_Localized: "Orta saha oyuncusu olarak bir sonraki yetene\u011Finiz, topu oyuncunuzla
      birlikte s\xFCr\xFCkledi\u011Finiz bir rulet hareketi veya d\xF6n\xFC\u015F
      hareketi yapman\u0131za olanak tan\u0131r. Bu hareketi yapmak size hafif bir
      h\u0131z art\u0131\u015F\u0131 da sa\u011Flar. Bunu kullanmak i\xE7in son vuru\u015Fu
      yapan ki\u015Fi olmal\u0131 ve topa yeterince yak\u0131n olmal\u0131s\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769225
    m_Localized: "Bir defans oyuncusu (CB) olarak, iki savunma hamlesine eri\u015Fiminiz
      var. Birincisi \"\xF6ld\xFCrme\" olarak adland\u0131r\u0131l\u0131yor ve bunu
      kullanmak i\xE7in bir oyuncuyu ge\xE7ici olarak sersemletmek \xFCzere hedef
      alman\u0131z gerekiyor. Bu, sald\u0131r\u0131lar\u0131 durdurmada son derece
      etkili olabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769226
    m_Localized: "Bir sonraki savunma yetene\u011Finiz \"sapt\u0131rma\" olarak adland\u0131r\u0131l\u0131yor
      ve havadaki toplar\u0131 sapt\u0131rman\u0131za olanak tan\u0131yor. Bu \xF6zellik,
      y\xFCksek paslar\u0131 veya \u015Futlar\u0131 engellemek i\xE7in kullan\u0131labilir.
      \u0130yi kullan\u0131ld\u0131\u011F\u0131nda ger\xE7ekten g\xFC\xE7l\xFC bir
      \xF6zellik."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769227
    m_Localized: "Kaleci olarak herhangi bir yetene\u011Finiz olmayacak. Ancak, topa
      temas etti\u011Finde dal\u0131\u015F yapabilir ve topu savu\u015Fturabilirsiniz.
      Oyuncunuzun hareket etti\u011Fi y\xF6ne do\u011Fru dal\u0131\u015F yapmak i\xE7in
      \"D\" tu\u015Funa bas\u0131n ve havay\u0131 kapatmak i\xE7in dal\u0131\u015Ftan
      \xF6nce z\u0131play\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769228
    m_Localized: "Yere d\xFC\u015Ft\xFC\u011F\xFCn\xFCzde topu yakalamak i\xE7in
      \"C\" tu\u015Funa da basabilirsiniz. Sald\u0131r\u0131lar\u0131 tamamen durdurmak
      i\xE7in kullan\u0131\u015Fl\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769229
    m_Localized: "Top elinize ge\xE7ti\u011Finde iki se\xE7ene\u011Finiz var: topu
      yere vurarak paslamak veya topu yuvarlayarak paslamak. Yere vurarak paslamak
      i\xE7in normal bir vuru\u015F yapman\u0131z gerekecek (joystick'i \"S\" tu\u015Fuyla
      kullan\u0131n). Yere vurarak paslar, yuvarlayarak paslardan daha uza\u011Fa
      ve daha y\xFCkse\u011Fe gidebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769230
    m_Localized: "Topu yuvarlayarak pas vermek i\xE7in topun elinizde olmas\u0131
      gerekir. Ard\u0131ndan, topu s\xFCrerek \u015Fut \xE7ekin. Bu, k\u0131sa ama
      daha kontrol edilebilir bir pas sa\u011Flayacakt\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769231
    m_Localized: "E\u011Fitimi ba\u015Far\u0131yla tamamlad\u0131\u011F\u0131n\u0131z
      i\xE7in tebrikler! Art\u0131k temel bilgileri \xF6\u011Frendi\u011Finize g\xF6re,
      di\u011Fer oyuncularla tam bir \xE7evrimi\xE7i ma\xE7 oynayabilir veya bir
      antrenman sunucusuna kat\u0131larak becerilerinizi geli\u015Ftirmeye devam
      edebilirsiniz. Bu e\u011Fitimde ele al\u0131nmayan daha bir\xE7ok gizli teknik
      ve harika \u015Fey var. \u0130yi \u015Fanslar ve iyi e\u011Flenceler!"
    m_Metadata:
      m_Items: []
  - m_Id: 1163166833233920
    m_Localized: "\u0130LERLEMEK"
    m_Metadata:
      m_Items: []
  - m_Id: 1169828692414464
    m_Localized: "D\u0130L"
    m_Metadata:
      m_Items: []
  - m_Id: 1470623971332096
    m_Localized: "BA\u011ELANTI KAYBOLDU \\n LOB\u0130YE D\xD6N\xDCL\xDCYOR."
    m_Metadata:
      m_Items: []
  - m_Id: 1470624067801088
    m_Localized: "BA\u011ELANTI KAYBOLDU \\n LOB\u0130YE D\xD6N\xDCL\xDCYOR.."
    m_Metadata:
      m_Items: []
  - m_Id: 1470624067801089
    m_Localized: "BA\u011ELANTI KAYBOLDU \\n LOB\u0130YE D\xD6N\xDCL\xDCYOR..."
    m_Metadata:
      m_Items: []
  - m_Id: 1470624067801090
    m_Localized: "E\u011E\u0130T\u0130M SIRASINDA MEVCUT DE\u011E\u0130LD\u0130R"
    m_Metadata:
      m_Items: []
  - m_Id: 1496039209619456
    m_Localized: "Engellerin aras\u0131ndan ge\xE7 ({amountOfDetectorsPassed}/5)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619457
    m_Localized: "Top s\xFCrerek engelleri ge\xE7 ({amountOfDetectorsPassed}/8)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619458
    m_Localized: Gol at ({amountOfDetectorsPassed}/8)
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619459
    m_Localized: "G\xFC\xE7l\xFC vuru\u015Fla gol at ({amountOfDetectorsPassed}/3)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619460
    m_Localized: "H\u0131z yetene\u011Fini kullan ({amountOfDetectorsPassed}/1)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619461
    m_Localized: Topu kontrol et ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619462
    m_Localized: "Rulet yetene\u011Fini kullan ({amountOfDetectorsPassed}/1)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619463
    m_Localized: "Bitirici yetene\u011Fi kullan ({amountOfDetectorsPassed}/1)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619464
    m_Localized: "Sapt\u0131rma yetene\u011Fini kullan ({amountOfDetectorsPassed}/1)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619465
    m_Localized: "Atlay\u0131p topu kurtar ({amountOfDetectorsPassed}/3)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619466
    m_Localized: Topu yakala ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619467
    m_Localized: Drop kick ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039209619468
    m_Localized: Topu yakala ve yuvarlan ({amountOfDetectorsPassed}3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520733
  - m_Id: 1496039218008064
    m_Localized: "TOPU SIFIRLAMAK \u0130\xC7\u0130N TOP S\u0130MGES\u0130NE BASIN"
    m_Metadata:
      m_Items: []
  - m_Id: 1500994368753664
    m_Localized: "TOPU SIFIRLAMAK \u0130\xC7\u0130N R TU\u015EUNA BASIN"
    m_Metadata:
      m_Items: []
  - m_Id: 1514414178619392
    m_Localized: "(B\u0130LG\u0130 \u0130\xC7\u0130N TIKLAYIN)"
    m_Metadata:
      m_Items: []
  - m_Id: 1514414245728256
    m_Localized: NORMAL
    m_Metadata:
      m_Items: []
  - m_Id: 1514414245728257
    m_Localized: "DE\u011E\u0130\u015ET\u0130R\u0130LM\u0130\u015E"
    m_Metadata:
      m_Items: []
