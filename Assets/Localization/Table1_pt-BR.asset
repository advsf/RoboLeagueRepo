  - m_Id: 1470624067801088
    m_Localized: "CONEX\xC3O PERDIDA \\n RETORNANDO AO LOBBY.."
    m_Metadata:
      m_Items: []
  - m_Id: 1470624067801089
    m_Localized: "CONEX\xC3O PERDIDA \\n RETORNANDO AO LOBBY..."
    m_Metadata:
      m_Items: []
  - m_Id: 1470624067801090
    m_Localized: "N\xC3O DISPON\xCDVEL DURANTE O TUTORIAL"
    m_Metadata:
      m_Items: []
  - m_Id: 1496039209619456
    m_Localized: Passe pelas barreiras ({amountOfDetectorsPassed}/5)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619457
    m_Localized: Drible pelas barreiras ({amountOfDetectorsPassed}/8)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619458
    m_Localized: Marque um gol ({amountOfDetectorsPassed}/8)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619459
    m_Localized: Marque um gol com chute poderoso ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619460
    m_Localized: Use a habilidade de velocidade ({amountOfDetectorsPassed}/1)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619461
    m_Localized: Domine a bola ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619462
    m_Localized: Use a habilidade de roleta ({amountOfDetectorsPassed}/1)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619463
    m_Localized: "Use a habilidade de finaliza\xE7\xE3o ({amountOfDetectorsPassed}/1)"
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619464
    m_Localized: Use a habilidade de desvio ({amountOfDetectorsPassed}/1)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619465
    m_Localized: Mergulhe e desvie a bola ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619466
    m_Localized: Pegue a bola ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619467
    m_Localized: Chute de primeira ({amountOfDetectorsPassed}/3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039209619468
    m_Localized: Pegue a bola e role ({amountOfDetectorsPassed}3)
    m_Metadata:
      m_Items:
      - rid: 752613887239520734
  - m_Id: 1496039218008064
    m_Localized: "Pressione o \xEDcone da bola para reiniciar a bola."
    m_Metadata:
      m_Items: []
  - m_Id: 1500994368753664
    m_Localized: Pressione R para reiniciar a bola.
    m_Metadata:
      m_Items: []
  - m_Id: 1514414178619392
    m_Localized: "(CLIQUE PARA MAIS INFORMA\xC7\xD5ES)"
    m_Metadata:
      m_Items: []
