  - m_Id: 1156324417654784
    m_Localized: "\u0623\u062F\u062E\u0644 \u0627\u0644\u0646\u0635..."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875371048960
    m_Localized: "\u0623\u0647\u0644\u0627\u064B \u0628\u0643\u0645 \u0641\u064A
      \u0647\u0630\u0627 \u0627\u0644\u062F\u0631\u0633 \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u064A!
      \u0641\u064A \u0627\u0644\u0645\u0631\u062D\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649\u060C
      \u0633\u062A\u062A\u0639\u0644\u0645\u0648\u0646 \u0623\u0633\u0627\u0633\u064A\u0627\u062A
      \u0627\u0644\u062D\u0631\u0643\u0629. \u0627\u0633\u062A\u062E\u062F\u0645\u0648\u0627
      \u0645\u0641\u0627\u062A\u064A\u062D WASD \u0644\u0644\u062A\u062D\u0631\u0643\u060C
      \u0648\u0645\u0641\u062A\u0627\u062D Shift \u0627\u0644\u0623\u064A\u0633\u0631
      \u0644\u0644\u0631\u0643\u0636\u060C \u0648\u0645\u0641\u062A\u0627\u062D \u0627\u0644\u0645\u0633\u0627\u0641\u0629
      \u0644\u0644\u0642\u0641\u0632\u060C \u0648\u0645\u0641\u062A\u0627\u062D Control
      \u0627\u0644\u0623\u064A\u0633\u0631 \u0644\u0644\u0627\u0646\u0632\u0644\u0627\u0642\u060C
      \u0648\u0645\u0641\u062A\u0627\u062D E \u0644\u0644\u0627\u0646\u062F\u0641\u0627\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574912
    m_Localized: "\u064A\u0645\u0643\u0646\u0643 \u0632\u064A\u0627\u062F\u0629 \u0642\u0648\u0629
      \u0627\u0644\u0643\u0631\u0629 \u0628\u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642
      \u0646\u062D\u0648\u0647\u0627 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
      \u0632\u0631 \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u0623\u064A\u0633\u0631.
      \u0647\u0630\u0627 \u0645\u0641\u064A\u062F \u0644\u0625\u062E\u0631\u0627\u062C
      \u0627\u0644\u0643\u0631\u0629 \u0645\u0646 \u0628\u064A\u0646 \u0623\u064A\u062F\u064A
      \u0627\u0644\u062E\u0635\u0648\u0645 \u0623\u0648 \u0644\u0635\u062F \u062A\u0633\u062F\u064A\u062F\u0629
      \u0623\u0631\u0636\u064A\u0629 \u0642\u0648\u064A\u0629. \u0627\u0644\u0622\u0646\u060C
      \u0627\u0646\u0632\u0644\u0642 \u0628\u0627\u0644\u0643\u0631\u0629 \u0646\u062D\u0648
      \u0627\u0644\u062D\u0627\u062C\u0632."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574913
    m_Localized: "\u0628\u0639\u062F \u0630\u0644\u0643\u060C \u0633\u062A\u062A\u0639\u0644\u0645
      \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u0645\u0631\u0627\u0648\u063A\u0629.
      \u0627\u0633\u062A\u062E\u062F\u0645 \u0632\u0631 \u0627\u0644\u0641\u0623\u0631\u0629
      \u0627\u0644\u0623\u064A\u0645\u0646 \u0644\u062A\u0641\u0639\u064A\u0644 \u062D\u0631\u0643\u0629
      \u0627\u0644\u0645\u0631\u0627\u0648\u063A\u0629\u060C \u0645\u0645\u0627 \u064A\u062C\u0639\u0644
      \u0627\u0644\u0643\u0631\u0629 \u062A\u062A\u0628\u0639 \u0627\u062A\u062C\u0627\u0647
      \u0644\u0627\u0639\u0628\u0643. \u0647\u0630\u0647 \u0627\u0644\u062D\u0631\u0643\u0629
      \u0645\u0641\u064A\u062F\u0629 \u0644\u0627\u062E\u062A\u0631\u0627\u0642 \u0627\u0644\u062F\u0641\u0627\u0639\u0627\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574914
    m_Localized: "\u0633\u062A\u062A\u0639\u0644\u0645 \u0627\u0644\u0622\u0646 \u0643\u064A\u0641\u064A\u0629
      \u0627\u0644\u062A\u0633\u062F\u064A\u062F. \u0627\u0636\u063A\u0637 \u0628\u0627\u0633\u062A\u0645\u0631\u0627\u0631
      \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0641\u0623\u0631\u0629 \u0627\u0644\u0623\u064A\u0633\u0631
      \u0644\u0634\u062D\u0646 \u0627\u0644\u0631\u0643\u0644\u0629. \u064A\u0645\u0643\u0646\u0643
      \u0632\u064A\u0627\u062F\u0629 \u0627\u0631\u062A\u0641\u0627\u0639 \u0627\u0644\u0643\u0631\u0629
      \u0628\u0627\u0644\u0646\u0638\u0631 \u0644\u0644\u0623\u0639\u0644\u0649 \u0642\u0628\u0644
      \u0631\u0643\u0644\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574915
    m_Localized: "\u0627\u0644\u0622\u0646 \u0648\u0642\u062F \u062A\u0639\u0644\u0645\u062A
      \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u060C
      \u0633\u062A\u062A\u0639\u0644\u0645 \u0643\u064A\u0641\u064A\u0629 \u0625\u0636\u0627\u0641\u0629
      \u0627\u0644\u062F\u0648\u0631\u0627\u0646 \u0644\u0644\u0643\u0631\u0629.
      \u0645\u0627 \u0639\u0644\u064A\u0643 \u0633\u0648\u0649 \u062A\u062D\u0631\u064A\u0643
      \u0627\u0644\u0643\u0631\u0629 \u0628\u0641\u0623\u0631\u0629 \u0627\u0644\u0645\u0627\u0648\u0633
      \u0642\u0628\u0644 \u0627\u0644\u062A\u0633\u062F\u064A\u062F \u0644\u062C\u0639\u0644\u0647\u0627
      \u062A\u062F\u0648\u0631 \u0641\u064A \u0630\u0644\u0643 \u0627\u0644\u0627\u062A\u062C\u0627\u0647.
      \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u0627\u062A \u0627\u0644\u062F\u0648\u0631\u0627\u0646\u064A\u0629
      \u0623\u0633\u0631\u0639 \u0645\u0646 \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u0627\u062A
      \u0627\u0644\u0639\u0627\u062F\u064A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574916
    m_Localized: "\u0644\u0643\u0644 \u0645\u0631\u0643\u0632 \u0642\u062F\u0631\u062A\u0627\u0646
      \u0641\u0631\u064A\u062F\u062A\u0627\u0646 (\u0628\u0627\u0633\u062A\u062B\u0646\u0627\u0621
      \u0645\u0631\u0627\u0643\u0632 \u062E\u0637 \u0627\u0644\u0648\u0633\u0637).
      \u0628\u062F\u0621\u064B\u0627 \u0645\u0646 \u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u0647\u0627\u062C\u0645
      \u0627\u0644\u0635\u0631\u064A\u062D\u060C \u062A\u062A\u064A\u062D \u0644\u0643
      \u0642\u062F\u0631\u0629 \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u0629 \u0627\u0644\u0642\u0648\u064A\u0629
      \u0627\u0644\u062A\u0633\u062F\u064A\u062F \u0628\u0642\u0648\u0629 \u0623\u0643\u0628\u0631\u060C
      \u0634\u0631\u064A\u0637\u0629 \u0623\u0646 \u062A\u064F\u062D\u0633\u0650\u0646
      \u062A\u0648\u0642\u064A\u062A \u0645\u0624\u0634\u0631 \u0627\u0644\u062A\u0633\u062F\u064A\u062F.
      \u0648\u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649 \u062A\u0648\u0642\u064A\u062A
      \u0645\u062B\u0627\u0644\u064A\u060C \u064A\u062C\u0628 \u0639\u0644\u064A\u0643
      \u0631\u0641\u0639 \u0625\u0635\u0628\u0639\u0643 \u0639\u0646 \u0627\u0644\u0632\u0631
      \u0639\u0646\u062F\u0645\u0627 \u064A\u0644\u0627\u0645\u0633 \u0627\u0644\u0645\u0624\u0634\u0631
      \u0627\u0644\u062C\u0632\u0621 \u0627\u0644\u0623\u0628\u064A\u0636."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574917
    m_Localized: "\u062A\u062A\u064A\u062D \u0644\u0643 \u0642\u062F\u0631\u0629
      \"\u0627\u0644\u0633\u0631\u0639\u0629\" \u0627\u0644\u062A\u0627\u0644\u064A\u0629
      \u0644\u0644\u0627\u0639\u0628 \"\u0633\u064A \u0625\u0641\" \u0627\u0644\u062A\u062D\u0631\u0643
      \u0628\u0633\u0631\u0639\u0629 \u0623\u0643\u0628\u0631 \u0644\u0641\u062A\u0631\u0629
      \u0642\u0635\u064A\u0631\u0629. \u064A\u0645\u0643\u0646 \u0627\u0633\u062A\u062E\u062F\u0627\u0645
      \u0647\u0630\u0647 \u0627\u0644\u0642\u062F\u0631\u0629 \u0644\u0644\u0631\u0643\u0636
      \u0627\u0644\u0633\u0631\u064A\u0639 \u0639\u0628\u0631 \u0627\u0644\u062F\u0641\u0627\u0639\u0627\u062A
      \u0648\u062E\u0644\u0642 \u0641\u0631\u0635 \u0647\u062C\u0648\u0645\u064A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574918
    m_Localized: "\u0628\u0635\u0641\u062A\u0643 \u0644\u0627\u0639\u0628 \u0648\u0633\u0637
      (\u064A\u0633\u0627\u0631/\u064A\u0645\u064A\u0646)\u060C \u0633\u062A\u062A\u0645\u0643\u0646
      \u0645\u0646 \"\u0627\u0644\u0633\u064A\u0637\u0631\u0629\" \u0639\u0644\u0649
      \u0627\u0644\u0643\u0631\u0629\u060C \u0623\u0648 \u0625\u064A\u0642\u0627\u0641
      \u0633\u0631\u0639\u062A\u0647\u0627 \u062A\u0645\u0627\u0645\u064B\u0627.
      \u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u064A\u0632\u0629\u060C
      \u0639\u0644\u064A\u0643 \u0627\u0644\u0627\u0642\u062A\u0631\u0627\u0628 \u0645\u0646
      \u0627\u0644\u0643\u0631\u0629 \u0648\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627.
      \u0648\u0647\u064A \u0645\u0641\u064A\u062F\u0629 \u0644\u0627\u0644\u062A\u0642\u0627\u0637
      \u0627\u0644\u062A\u0645\u0631\u064A\u0631\u0627\u062A \u0627\u0644\u0639\u0627\u0644\u064A\u0629
      \u0623\u0648 \u0627\u0644\u0643\u0631\u0627\u062A \u0627\u0644\u0633\u0631\u064A\u0639\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574919
    m_Localized: "\u062A\u062A\u064A\u062D \u0644\u0643 \u0642\u062F\u0631\u062A\u0643
      \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u0643\u0644\u0627\u0639\u0628 \u062E\u0637
      \u0648\u0633\u0637 \u062A\u0646\u0641\u064A\u0630 \u062D\u0631\u0643\u0629
      \u0627\u0644\u062F\u0648\u0631\u0627\u0646\u060C \u0623\u0648 \u062D\u0631\u0643\u0629
      \u0627\u0644\u062F\u0648\u0631\u0627\u0646 \u0627\u0644\u062A\u064A \u062A\u0633\u062D\u0628
      \u0627\u0644\u0643\u0631\u0629 \u0645\u0639 \u0644\u0627\u0639\u0628\u0643.
      \u0643\u0645\u0627 \u062A\u0645\u0646\u062D\u0643 \u0647\u0630\u0647 \u0627\u0644\u062D\u0631\u0643\u0629
      \u062F\u0641\u0639\u0629 \u0633\u0631\u0639\u0629 \u0637\u0641\u064A\u0641\u0629.
      \u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627\u060C \u064A\u062C\u0628
      \u0623\u0646 \u062A\u0643\u0648\u0646 \u0622\u062E\u0631 \u0645\u0646 \u064A\u0633\u062F\u062F
      \u0627\u0644\u0643\u0631\u0629 \u0648\u0623\u0646 \u062A\u0643\u0648\u0646
      \u0642\u0631\u064A\u0628\u064B\u0627 \u0645\u0646\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574920
    m_Localized: "\u0628\u0635\u0641\u062A\u0643 \u0645\u062F\u0627\u0641\u0639\u064B\u0627
      (\u0642\u0644\u0628 \u062F\u0641\u0627\u0639)\u060C \u0644\u062F\u064A\u0643
      \u062D\u0631\u0643\u062A\u0627\u0646 \u062F\u0641\u0627\u0639\u064A\u062A\u0627\u0646.
      \u0627\u0644\u0623\u0648\u0644\u0649 \u062A\u0633\u0645\u0649 \"\u0627\u0644\u0642\u062A\u0644\"\u060C
      \u0648\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627 \u064A\u062C\u0628
      \u0639\u0644\u064A\u0643 \u0627\u0644\u062A\u0635\u0648\u064A\u0628 \u0639\u0644\u0649
      \u0644\u0627\u0639\u0628 \u0644\u0634\u0644 \u062D\u0631\u0643\u062A\u0647
      \u0645\u0624\u0642\u062A\u064B\u0627. \u064A\u0645\u0643\u0646 \u0623\u0646
      \u064A\u0643\u0648\u0646 \u0647\u0630\u0627 \u0641\u0639\u0627\u0644\u064B\u0627
      \u0644\u0644\u063A\u0627\u064A\u0629 \u0641\u064A \u0625\u064A\u0642\u0627\u0641
      \u0627\u0644\u0647\u062C\u0645\u0627\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574921
    m_Localized: "\u0642\u062F\u0631\u062A\u0643 \u0627\u0644\u062F\u0641\u0627\u0639\u064A\u0629
      \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u062A\u064F\u0633\u0645\u0649 \"\u0627\u0644\u062A\u0634\u062A\u064A\u062A\"\u060C
      \u0648\u0647\u064A \u062A\u064F\u0645\u0643\u0651\u0646\u0643 \u0645\u0646
      \u062A\u0634\u062A\u064A\u062A \u0627\u0644\u0643\u0631\u0627\u062A \u0641\u064A
      \u0627\u0644\u0647\u0648\u0627\u0621. \u064A\u064F\u0645\u0643\u0646 \u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627
      \u0644\u0635\u062F\u0651 \u0627\u0644\u062A\u0645\u0631\u064A\u0631\u0627\u062A
      \u0627\u0644\u0639\u0627\u0644\u064A\u0629 \u0623\u0648 \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u0627\u062A.
      \u0625\u0646\u0647\u0627 \u0641\u0639\u0651\u0627\u0644\u0629 \u0644\u0644\u063A\u0627\u064A\u0629
      \u0625\u0630\u0627 \u0627\u0633\u062A\u064F\u062E\u062F\u0645\u062A \u0628\u0645\u0647\u0627\u0631\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574922
    m_Localized: "\u0628\u0635\u0641\u062A\u0643 \u062D\u0627\u0631\u0633 \u0645\u0631\u0645\u0649\u060C
      \u0644\u0646 \u062A\u0645\u062A\u0644\u0643 \u0623\u064A \u0642\u062F\u0631\u0627\u062A
      \u062E\u0627\u0635\u0629. \u0645\u0639 \u0630\u0644\u0643\u060C \u064A\u0645\u0643\u0646\u0643
      \u0627\u0644\u0627\u0646\u0642\u0636\u0627\u0636 \u0639\u0644\u0649 \u0627\u0644\u0643\u0631\u0629
      \u0648\u062A\u063A\u064A\u064A\u0631 \u0645\u0633\u0627\u0631\u0647\u0627 \u0639\u0646\u062F
      \u0645\u0644\u0627\u0645\u0633\u062A\u0647\u0627. \u0627\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0632\u0631 Q \u0644\u0644\u0627\u0646\u0642\u0636\u0627\u0636
      \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u062D\u0631\u0643\u0629 \u0644\u0627\u0639\u0628\u0643\u060C
      \u0648\u0627\u0642\u0641\u0632 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u0642\u0636\u0627\u0636
      \u0644\u062A\u063A\u0637\u064A\u0629 \u0627\u0644\u0645\u0633\u0627\u062D\u0629
      \u0641\u064A \u0627\u0644\u0647\u0648\u0627\u0621."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574923
    m_Localized: "\u064A\u0645\u0643\u0646\u0643 \u0623\u064A\u0636\u064B\u0627 \u0627\u0644\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0632\u0631 T \u0644\u0627\u0644\u062A\u0642\u0627\u0637
      \u0627\u0644\u0643\u0631\u0629 \u0639\u0646\u062F\u0645\u0627 \u062A\u0643\u0648\u0646
      \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636. \u062A\u0623\u0643\u062F
      \u0645\u0646 \u0623\u0646\u0643 \u0641\u0648\u0642 \u0627\u0644\u0643\u0631\u0629
      \u062A\u0645\u0627\u0645\u064B\u0627 \u0644\u062A\u062A\u0645\u0643\u0646 \u0645\u0646
      \u0627\u0644\u062A\u0642\u0627\u0637\u0647\u0627. \u0647\u0630\u0647 \u0627\u0644\u062D\u0631\u0643\u0629
      \u0645\u0641\u064A\u062F\u0629 \u0644\u0625\u064A\u0642\u0627\u0641 \u0627\u0644\u0647\u062C\u0645\u0627\u062A
      \u062A\u0645\u0627\u0645\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574924
    m_Localized: "\u0628\u0645\u062C\u0631\u062F \u0623\u0646 \u062A\u0635\u0628\u062D
      \u0627\u0644\u0643\u0631\u0629 \u0628\u064A\u0646 \u064A\u062F\u064A\u0643\u060C
      \u0644\u062F\u064A\u0643 \u062E\u064A\u0627\u0631\u0627\u0646: \u0631\u0643\u0644
      \u0627\u0644\u0643\u0631\u0629 \u0628\u0642\u0648\u0629 \u0623\u0648 \u062F\u062D\u0631\u062C\u062A\u0647\u0627.
      \u0644\u062A\u0646\u0641\u064A\u0630 \u0631\u0643\u0644\u0629 \u0642\u0648\u064A\u0629\u060C
      \u0627\u0633\u062A\u062E\u062F\u0645 \u0632\u0631 \u0627\u0644\u0641\u0623\u0631\u0629
      \u0627\u0644\u0623\u064A\u0633\u0631 \u0644\u0634\u062D\u0646\u0647\u0627\u060C
      \u062A\u0645\u0627\u0645\u064B\u0627 \u0643\u0645\u0627 \u062A\u0641\u0639\u0644
      \u0639\u0646\u062F \u0634\u062D\u0646 \u0627\u0644\u0631\u0643\u0644\u0629
      \u0627\u0644\u0639\u0627\u062F\u064A\u0629. \u062A\u062A\u0645\u064A\u0632
      \u0627\u0644\u0631\u0643\u0644\u0627\u062A \u0627\u0644\u0642\u0648\u064A\u0629
      \u0628\u0623\u0646\u0647\u0627 \u062A\u0635\u0644 \u0625\u0644\u0649 \u0645\u0633\u0627\u0641\u0629
      \u0623\u0628\u0639\u062F \u0648\u0623\u0639\u0644\u0649 \u0645\u0646 \u0627\u0644\u062A\u0645\u0631\u064A\u0631\u0629
      \u0627\u0644\u0639\u0627\u062F\u064A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574925
    m_Localized: "\u0644\u062A\u0646\u0641\u064A\u0630 \u062A\u0645\u0631\u064A\u0631\u0629
      \u0633\u0631\u064A\u0639\u0629\u060C \u064A\u062C\u0628 \u0623\u0646 \u062A\u0643\u0648\u0646
      \u0627\u0644\u0643\u0631\u0629 \u0628\u064A\u0646 \u064A\u062F\u064A\u0643.
      \u062B\u0645 \u0627\u0636\u063A\u0637 \u0628\u0627\u0633\u062A\u0645\u0631\u0627\u0631
      \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0641\u0623\u0631\u0629 \u0627\u0644\u0623\u064A\u0645\u0646
      (\u0643\u0645\u0627 \u0647\u0648 \u0627\u0644\u062D\u0627\u0644 \u0639\u0646\u062F
      \u0627\u0644\u0645\u0631\u0627\u0648\u063A\u0629) \u0644\u062A\u062C\u0647\u064A\u0632
      \u0627\u0644\u062A\u0645\u0631\u064A\u0631\u0629\u060C \u062B\u0645 \u0627\u0631\u0641\u0639
      \u0625\u0635\u0628\u0639\u0643 \u0639\u0646 \u0627\u0644\u0632\u0631 \u0644\u0625\u0637\u0644\u0627\u0642
      \u0627\u0644\u0643\u0631\u0629. \u0633\u064A\u0624\u062F\u064A \u0647\u0630\u0627
      \u0625\u0644\u0649 \u062A\u0646\u0641\u064A\u0630 \u062A\u0645\u0631\u064A\u0631\u0629
      \u0642\u0635\u064A\u0631\u0629 \u0648\u0644\u0643\u0646\u0647\u0627 \u0623\u0643\u062B\u0631
      \u062A\u062D\u0643\u0645\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574926
    m_Localized: "\u062A\u0647\u0627\u0646\u064A\u0646\u0627 \u0639\u0644\u0649 \u0627\u062C\u062A\u064A\u0627\u0632
      \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u064A!
      \u0627\u0644\u0622\u0646 \u0648\u0642\u062F \u062A\u0639\u0644\u0645\u062A
      \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0627\u062A\u060C \u064A\u0645\u0643\u0646\u0643
      \u0625\u0645\u0627 \u062E\u0648\u0636 \u0645\u0628\u0627\u0631\u0627\u0629
      \u0643\u0627\u0645\u0644\u0629 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062A\u0631\u0646\u062A
      \u0645\u0639 \u0644\u0627\u0639\u0628\u064A\u0646 \u0622\u062E\u0631\u064A\u0646
      \u0623\u0648 \u0645\u0648\u0627\u0635\u0644\u0629 \u062A\u0637\u0648\u064A\u0631
      \u0645\u0647\u0627\u0631\u0627\u062A\u0643 \u0628\u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645
      \u0625\u0644\u0649 \u062E\u0627\u062F\u0645 \u062A\u062F\u0631\u064A\u0628.
      \u0647\u0646\u0627\u0643 \u0627\u0644\u0643\u062B\u064A\u0631 \u0645\u0646
      \u0627\u0644\u062A\u0642\u0646\u064A\u0627\u062A \u0627\u0644\u062E\u0641\u064A\u0629
      \u0648\u0627\u0644\u0645\u064A\u0632\u0627\u062A \u0627\u0644\u0631\u0627\u0626\u0639\u0629
      \u0627\u0644\u062A\u064A \u0644\u0645 \u064A\u062A\u0646\u0627\u0648\u0644\u0647\u0627
      \u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u064A.
      \u062D\u0638\u0627\u064B \u0645\u0648\u0641\u0642\u0627\u064B\u060C \u0648\u0627\u0633\u062A\u0645\u062A\u0639!"
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769216
    m_Localized: "\u0623\u0647\u0644\u0627\u064B \u0628\u0643\u0645 \u0641\u064A
      \u0647\u0630\u0627 \u0627\u0644\u062F\u0631\u0633 \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u064A!
      \u0641\u064A \u0627\u0644\u0645\u0631\u062D\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649\u060C
      \u0633\u062A\u062A\u0639\u0644\u0645\u0648\u0646 \u0623\u0633\u0627\u0633\u064A\u0627\u062A
      \u0627\u0644\u062D\u0631\u0643\u0629. \u0627\u0633\u062A\u062E\u062F\u0645\u0648\u0627
      \u0639\u0635\u0627 \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u064A\u0633\u0631\u0649
      \u0644\u0644\u0645\u0634\u064A\u060C \u0648\u0627\u062F\u0641\u0639\u0648\u0647\u0627
      \u0628\u0642\u0648\u0629 \u0623\u0643\u0628\u0631 \u0644\u0644\u0631\u0643\u0636.
      \u0639\u0644\u0649 \u0627\u0644\u064A\u0645\u064A\u0646\u060C \u064A\u0645\u0643\u0646\u0643\u0645
      \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0632\u0631\u0627\u0631
      \u0627\u0644\u062B\u0644\u0627\u062B\u0629 \u0644\u0644\u0642\u0641\u0632 \u0648\u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642
      \u0648\u0627\u0644\u0627\u0646\u062F\u0641\u0627\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769217
    m_Localized: "\u064A\u0645\u0643\u0646\u0643 \u0632\u064A\u0627\u062F\u0629 \u0642\u0648\u0629
      \u0627\u0644\u0643\u0631\u0629 \u0628\u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642
      \u0646\u062D\u0648\u0647\u0627 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
      \u0632\u0631 \u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642. \u0647\u0630\u0627
      \u0645\u0641\u064A\u062F \u0644\u0625\u062E\u0631\u0627\u062C \u0627\u0644\u0643\u0631\u0629
      \u0645\u0646 \u0628\u064A\u0646 \u0623\u064A\u062F\u064A \u0627\u0644\u062E\u0635\u0648\u0645
      \u0623\u0648 \u0644\u0635\u062F \u062A\u0633\u062F\u064A\u062F\u0629 \u0623\u0631\u0636\u064A\u0629
      \u0642\u0648\u064A\u0629. \u0627\u0644\u0622\u0646\u060C \u0627\u0646\u0632\u0644\u0642
      \u0628\u0627\u0644\u0643\u0631\u0629 \u0646\u062D\u0648 \u0627\u0644\u062D\u0627\u062C\u0632."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769218
    m_Localized: "\u0628\u0639\u062F \u0630\u0644\u0643\u060C \u0633\u062A\u062A\u0639\u0644\u0645
      \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u0645\u0631\u0627\u0648\u063A\u0629.
      \u0627\u0633\u062A\u062E\u062F\u0645 \u0639\u0635\u0627 \u0627\u0644\u062A\u062D\u0643\u0645
      \u0627\u0644\u064A\u0645\u0646\u0649 \u0645\u0639 \u0632\u0631 \"D\" \u0648\u0627\u0636\u063A\u0637
      \u0639\u0644\u064A\u0647 \u0628\u0627\u0633\u062A\u0645\u0631\u0627\u0631 \u0644\u062A\u0646\u0641\u064A\u0630
      \u062D\u0631\u0643\u0629 \u0627\u0644\u0645\u0631\u0627\u0648\u063A\u0629.
      \u0633\u062A\u062A\u062D\u0631\u0643 \u0627\u0644\u0643\u0631\u0629 \u0641\u064A
      \u0627\u0644\u0627\u062A\u062C\u0627\u0647 \u0627\u0644\u0630\u064A \u062A\u062D\u0631\u0643
      \u0641\u064A\u0647 \u0639\u0635\u0627 \u0627\u0644\u062A\u062D\u0643\u0645.
      \u0647\u0630\u0647 \u0627\u0644\u062D\u0631\u0643\u0629 \u0645\u0641\u064A\u062F\u0629
      \u0644\u0627\u062E\u062A\u0631\u0627\u0642 \u0627\u0644\u062F\u0641\u0627\u0639\u0627\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769219
    m_Localized: "\u0633\u062A\u062A\u0639\u0644\u0645 \u0627\u0644\u0622\u0646 \u0643\u064A\u0641\u064A\u0629
      \u0627\u0644\u062A\u0635\u0648\u064A\u0628. \u0627\u0636\u063A\u0637 \u0639\u0644\u0649
      \u0639\u0635\u0627 \u0627\u0644\u062A\u062D\u0643\u0645 \u0645\u0639 \u0632\u0631
      \"S\" \u0644\u0634\u062D\u0646 \u0627\u0644\u0631\u0643\u0644\u0629. \u064A\u0645\u0643\u0646\u0643
      \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u0627\u0631\u062A\u0641\u0627\u0639
      \u0628\u062A\u062D\u0631\u064A\u0643 \u0627\u0644\u0643\u0627\u0645\u064A\u0631\u0627
      \u0644\u0644\u0623\u0639\u0644\u0649 \u0642\u0628\u0644 \u0627\u0644\u0631\u0643\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769220
    m_Localized: "\u0627\u0644\u0622\u0646 \u0648\u0642\u062F \u062A\u0639\u0644\u0645\u062A
      \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u0631\u0643\u0644\u060C \u0633\u062A\u062A\u0639\u0644\u0645
      \u0643\u064A\u0641\u064A\u0629 \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u062F\u0648\u0631\u0627\u0646
      \u0644\u0644\u0643\u0631\u0629. \u0648\u0643\u0645\u0627 \u0647\u0648 \u0627\u0644\u062D\u0627\u0644
      \u0641\u064A \u0627\u0644\u0645\u0631\u0627\u0648\u063A\u0629\u060C \u0641\u0625\u0646
      \u0627\u062A\u062C\u0627\u0647 \u0639\u0635\u0627 \u0627\u0644\u062A\u062D\u0643\u0645
      \u0633\u064A\u062D\u062F\u062F \u0627\u062A\u062C\u0627\u0647 \u0627\u0644\u062F\u0648\u0631\u0627\u0646.
      \u0643\u0645\u0627 \u0623\u0646 \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u0627\u062A
      \u0627\u0644\u062F\u0648\u0631\u0627\u0646\u064A\u0629 \u0623\u0633\u0631\u0639
      \u0645\u0646 \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u0627\u062A \u0627\u0644\u0639\u0627\u062F\u064A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769221
    m_Localized: "\u0644\u0643\u0644 \u0645\u0631\u0643\u0632 \u0642\u062F\u0631\u062A\u0627\u0646
      \u0641\u0631\u064A\u062F\u062A\u0627\u0646. \u0628\u062F\u0621\u064B\u0627
      \u0645\u0646 \u0645\u0631\u0643\u0632 \u0627\u0644\u0647\u062C\u0648\u0645
      \u0627\u0644\u0623\u0645\u0627\u0645\u064A (CF)\u060C \u062A\u062A\u064A\u062D
      \u0644\u0643 \u0642\u062F\u0631\u0629 \u0627\u0644\u0631\u0643\u0644\u0629
      \u0627\u0644\u0642\u0648\u064A\u0629 \u0627\u0644\u062A\u0633\u062F\u064A\u062F
      \u0628\u0642\u0648\u0629 \u0623\u0643\u0628\u0631\u060C \u0628\u0634\u0631\u0637
      \u0636\u0628\u0637 \u062A\u0648\u0642\u064A\u062A \u0645\u0624\u0634\u0631
      \u0627\u0644\u062A\u0633\u062F\u064A\u062F \u0628\u062F\u0642\u0629. \u0648\u0644\u0644\u062D\u0635\u0648\u0644
      \u0639\u0644\u0649 \u062A\u0648\u0642\u064A\u062A \u0645\u062B\u0627\u0644\u064A\u060C
      \u064A\u062C\u0628 \u0639\u0644\u064A\u0643 \u062A\u062D\u0631\u064A\u0631
      \u0627\u0644\u0632\u0631 \u0639\u0646\u062F\u0645\u0627 \u064A\u0644\u0627\u0645\u0633
      \u0627\u0644\u0645\u0624\u0634\u0631 \u0627\u0644\u062C\u0632\u0621 \u0627\u0644\u0623\u0628\u064A\u0636.
      \u064A\u0645\u0643\u0646\u0643 \u062A\u0641\u0639\u064A\u0644\u0647\u0627 \u0628\u0627\u0644\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0632\u0631 \"L\" \u0645\u0631\u062A\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769222
    m_Localized: "\u062A\u062A\u064A\u062D \u0644\u0643 \u0642\u062F\u0631\u0629
      \"\u0627\u0644\u0633\u0631\u0639\u0629\" \u0627\u0644\u062A\u0627\u0644\u064A\u0629
      \u0641\u064A \u0644\u0639\u0628\u0629 \"\u0633\u064A \u0625\u0641\" \u0627\u0644\u062A\u062D\u0631\u0643
      \u0628\u0633\u0631\u0639\u0629 \u0623\u0643\u0628\u0631 \u0644\u0641\u062A\u0631\u0629
      \u0648\u062C\u064A\u0632\u0629. \u064A\u0645\u0643\u0646\u0643 \u0627\u0633\u062A\u062E\u062F\u0627\u0645
      \u0647\u0630\u0647 \u0627\u0644\u0642\u062F\u0631\u0629 \u0644\u0627\u062E\u062A\u0631\u0627\u0642
      \u0627\u0644\u062F\u0641\u0627\u0639\u0627\u062A \u0628\u0633\u0631\u0639\u0629
      \u0648\u062E\u0644\u0642 \u0641\u0631\u0635 \u0647\u062C\u0648\u0645\u064A\u0629.
      \u064A\u0645\u0643\u0646\u0643 \u062A\u0641\u0639\u064A\u0644\u0647\u0627 \u0628\u0627\u0644\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0632\u0631 \"R\" \u0645\u0631\u062A\u064A\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769223
    m_Localized: "\u0628\u0635\u0641\u062A\u0643 \u0644\u0627\u0639\u0628 \u0648\u0633\u0637
      (\u064A\u0633\u0627\u0631/\u064A\u0645\u064A\u0646)\u060C \u0633\u062A\u062A\u0645\u0643\u0646
      \u0645\u0646 \"\u0627\u0644\u0633\u064A\u0637\u0631\u0629\" \u0639\u0644\u0649
      \u0627\u0644\u0643\u0631\u0629\u060C \u0623\u0648 \u0625\u064A\u0642\u0627\u0641
      \u0633\u0631\u0639\u062A\u0647\u0627 \u062A\u0645\u0627\u0645\u064B\u0627.
      \u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u064A\u0632\u0629\u060C
      \u0639\u0644\u064A\u0643 \u0627\u0644\u0627\u0642\u062A\u0631\u0627\u0628 \u0645\u0646
      \u0627\u0644\u0643\u0631\u0629 \u0648\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627.
      \u0648\u0647\u064A \u0645\u0641\u064A\u062F\u0629 \u0644\u0627\u0644\u062A\u0642\u0627\u0637
      \u0627\u0644\u062A\u0645\u0631\u064A\u0631\u0627\u062A \u0627\u0644\u0639\u0627\u0644\u064A\u0629
      \u0623\u0648 \u0627\u0644\u0643\u0631\u0627\u062A \u0627\u0644\u0633\u0631\u064A\u0639\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769224
    m_Localized: "\u062A\u062A\u064A\u062D \u0644\u0643 \u0642\u062F\u0631\u062A\u0643
      \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u0643\u0644\u0627\u0639\u0628 \u062E\u0637
      \u0648\u0633\u0637 \u062A\u0646\u0641\u064A\u0630 \u062D\u0631\u0643\u0629
      \u0627\u0644\u062F\u0648\u0631\u0627\u0646\u060C \u0623\u0648 \u062D\u0631\u0643\u0629
      \u0627\u0644\u062F\u0648\u0631\u0627\u0646 \u0627\u0644\u062A\u064A \u062A\u0633\u062D\u0628
      \u0627\u0644\u0643\u0631\u0629 \u0645\u0639 \u0644\u0627\u0639\u0628\u0643.
      \u0643\u0645\u0627 \u062A\u0645\u0646\u062D\u0643 \u0647\u0630\u0647 \u0627\u0644\u062D\u0631\u0643\u0629
      \u062F\u0641\u0639\u0629 \u0633\u0631\u0639\u0629 \u0637\u0641\u064A\u0641\u0629.
      \u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627\u060C \u064A\u062C\u0628
      \u0623\u0646 \u062A\u0643\u0648\u0646 \u0622\u062E\u0631 \u0645\u0646 \u064A\u0633\u062F\u062F
      \u0627\u0644\u0643\u0631\u0629 \u0648\u0623\u0646 \u062A\u0643\u0648\u0646
      \u0642\u0631\u064A\u0628\u064B\u0627 \u0645\u0646\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769225
    m_Localized: "\u0628\u0635\u0641\u062A\u0643 \u0645\u062F\u0627\u0641\u0639\u064B\u0627
      (\u0642\u0644\u0628 \u062F\u0641\u0627\u0639)\u060C \u0644\u062F\u064A\u0643
      \u062D\u0631\u0643\u062A\u0627\u0646 \u062F\u0641\u0627\u0639\u064A\u062A\u0627\u0646.
      \u0627\u0644\u0623\u0648\u0644\u0649 \u062A\u0633\u0645\u0649 \"\u0627\u0644\u0642\u062A\u0644\"\u060C
      \u0648\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627 \u064A\u062C\u0628
      \u0639\u0644\u064A\u0643 \u0627\u0644\u062A\u0635\u0648\u064A\u0628 \u0639\u0644\u0649
      \u0644\u0627\u0639\u0628 \u0644\u0634\u0644 \u062D\u0631\u0643\u062A\u0647
      \u0645\u0624\u0642\u062A\u064B\u0627. \u064A\u0645\u0643\u0646 \u0623\u0646
      \u064A\u0643\u0648\u0646 \u0647\u0630\u0627 \u0641\u0639\u0627\u0644\u064B\u0627
      \u0644\u0644\u063A\u0627\u064A\u0629 \u0641\u064A \u0625\u064A\u0642\u0627\u0641
      \u0627\u0644\u0647\u062C\u0645\u0627\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769226
    m_Localized: "\u0642\u062F\u0631\u062A\u0643 \u0627\u0644\u062F\u0641\u0627\u0639\u064A\u0629
      \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u062A\u064F\u0633\u0645\u0649 \"\u0627\u0644\u062A\u0634\u062A\u064A\u062A\"\u060C
      \u0648\u0647\u064A \u062A\u064F\u0645\u0643\u0651\u0646\u0643 \u0645\u0646
      \u062A\u0634\u062A\u064A\u062A \u0627\u0644\u0643\u0631\u0627\u062A \u0641\u064A
      \u0627\u0644\u0647\u0648\u0627\u0621. \u064A\u064F\u0645\u0643\u0646 \u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627
      \u0644\u0635\u062F\u0651 \u0627\u0644\u062A\u0645\u0631\u064A\u0631\u0627\u062A
      \u0627\u0644\u0639\u0627\u0644\u064A\u0629 \u0623\u0648 \u0627\u0644\u062A\u0633\u062F\u064A\u062F\u0627\u062A.
      \u0625\u0646\u0647\u0627 \u0641\u0639\u0651\u0627\u0644\u0629 \u0644\u0644\u063A\u0627\u064A\u0629
      \u0625\u0630\u0627 \u0627\u0633\u062A\u064F\u062E\u062F\u0645\u062A \u0628\u0645\u0647\u0627\u0631\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769227
    m_Localized: "\u0628\u0635\u0641\u062A\u0643 \u062D\u0627\u0631\u0633 \u0645\u0631\u0645\u0649\u060C
      \u0644\u0646 \u062A\u0645\u062A\u0644\u0643 \u0623\u064A \u0642\u062F\u0631\u0627\u062A
      \u062E\u0627\u0635\u0629. \u0645\u0639 \u0630\u0644\u0643\u060C \u064A\u0645\u0643\u0646\u0643
      \u0627\u0644\u0627\u0646\u0642\u0636\u0627\u0636 \u0639\u0644\u0649 \u0627\u0644\u0643\u0631\u0629
      \u0648\u062A\u063A\u064A\u064A\u0631 \u0645\u0633\u0627\u0631\u0647\u0627 \u0639\u0646\u062F
      \u0645\u0644\u0627\u0645\u0633\u062A\u0647\u0627. \u0627\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0632\u0631 \"D\" \u0644\u0644\u0627\u0646\u0642\u0636\u0627\u0636
      \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u062D\u0631\u0643\u0629 \u0644\u0627\u0639\u0628\u0643\u060C
      \u0648\u0627\u0642\u0641\u0632 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u0642\u0636\u0627\u0636
      \u0644\u062A\u063A\u0637\u064A\u0629 \u0627\u0644\u0645\u0633\u0627\u062D\u0629
      \u0641\u064A \u0627\u0644\u0647\u0648\u0627\u0621."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769228
    m_Localized: "\u064A\u0645\u0643\u0646\u0643 \u0623\u064A\u0636\u064B\u0627 \u0627\u0644\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0632\u0631 \"C\" \u0644\u0627\u0644\u062A\u0642\u0627\u0637
      \u0627\u0644\u0643\u0631\u0629 \u0639\u0646\u062F\u0645\u0627 \u062A\u0643\u0648\u0646
      \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636. \u0645\u0641\u064A\u062F
      \u0644\u0625\u064A\u0642\u0627\u0641 \u0627\u0644\u0647\u062C\u0645\u0627\u062A
      \u062A\u0645\u0627\u0645\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769229
    m_Localized: "\u0628\u0645\u062C\u0631\u062F \u0623\u0646 \u062A\u0635\u0628\u062D
      \u0627\u0644\u0643\u0631\u0629 \u0628\u064A\u0646 \u064A\u062F\u064A\u0643\u060C
      \u0644\u062F\u064A\u0643 \u062E\u064A\u0627\u0631\u0627\u0646: \u0631\u0643\u0644
      \u0627\u0644\u0643\u0631\u0629 \u0628\u0642\u0648\u0629 \u0623\u0648 \u062F\u062D\u0631\u062C\u062A\u0647\u0627.
      \u0644\u062A\u0646\u0641\u064A\u0630 \u0627\u0644\u0631\u0643\u0644\u0629 \u0627\u0644\u0642\u0648\u064A\u0629\u060C
      \u0639\u0644\u064A\u0643 \u0627\u0644\u0642\u064A\u0627\u0645 \u0628\u0631\u0643\u0644\u0629
      \u0639\u0627\u062F\u064A\u0629 (\u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
      \u0639\u0635\u0627 \u0627\u0644\u062A\u062D\u0643\u0645 \u0645\u0639 \u0632\u0631
      \"S\"). \u062A\u062A\u0645\u064A\u0632 \u0627\u0644\u0631\u0643\u0644\u0627\u062A
      \u0627\u0644\u0642\u0648\u064A\u0629 \u0628\u0623\u0646\u0647\u0627 \u062A\u0635\u0644
      \u0625\u0644\u0649 \u0645\u0633\u0627\u0641\u0629 \u0623\u0628\u0639\u062F
      \u0648\u0623\u0639\u0644\u0649 \u0645\u0646 \u0627\u0644\u062A\u0645\u0631\u064A\u0631\u0629
      \u0627\u0644\u0645\u062F\u062D\u0631\u062C\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769230
    m_Localized: "\u0644\u062A\u0646\u0641\u064A\u0630 \u062A\u0645\u0631\u064A\u0631\u0629
      \u0627\u0644\u062F\u0648\u0631\u0627\u0646\u060C \u064A\u062C\u0628 \u0623\u0646
      \u062A\u0643\u0648\u0646 \u0627\u0644\u0643\u0631\u0629 \u0628\u064A\u0646
      \u064A\u062F\u064A\u0643. \u062B\u0645 \u0642\u0645 \u0628\u062A\u0633\u062F\u064A\u062F\u0629
      \u0645\u0631\u0627\u0648\u063A\u0629. \u0633\u064A\u0624\u062F\u064A \u0630\u0644\u0643
      \u0625\u0644\u0649 \u062A\u0645\u0631\u064A\u0631\u0629 \u0642\u0635\u064A\u0631\u0629
      \u0648\u0644\u0643\u0646\u0647\u0627 \u0623\u0643\u062B\u0631 \u062A\u062D\u0643\u0645\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769231
    m_Localized: "\u062A\u0647\u0627\u0646\u064A\u0646\u0627 \u0639\u0644\u0649 \u0627\u062C\u062A\u064A\u0627\u0632
      \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u064A!
      \u0627\u0644\u0622\u0646 \u0648\u0642\u062F \u062A\u0639\u0644\u0645\u062A
      \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0627\u062A\u060C \u064A\u0645\u0643\u0646\u0643
      \u0625\u0645\u0627 \u062E\u0648\u0636 \u0645\u0628\u0627\u0631\u0627\u0629
      \u0643\u0627\u0645\u0644\u0629 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062A\u0631\u0646\u062A
      \u0645\u0639 \u0644\u0627\u0639\u0628\u064A\u0646 \u0622\u062E\u0631\u064A\u0646
      \u0623\u0648 \u0645\u0648\u0627\u0635\u0644\u0629 \u062A\u0637\u0648\u064A\u0631
      \u0645\u0647\u0627\u0631\u0627\u062A\u0643 \u0628\u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645
      \u0625\u0644\u0649 \u062E\u0627\u062F\u0645 \u062A\u062F\u0631\u064A\u0628.
      \u0647\u0646\u0627\u0643 \u0627\u0644\u0643\u062B\u064A\u0631 \u0645\u0646
      \u0627\u0644\u062A\u0642\u0646\u064A\u0627\u062A \u0627\u0644\u062E\u0641\u064A\u0629
      \u0648\u0627\u0644\u0645\u064A\u0632\u0627\u062A \u0627\u0644\u0631\u0627\u0626\u0639\u0629
      \u0627\u0644\u062A\u064A \u0644\u0645 \u064A\u062A\u0646\u0627\u0648\u0644\u0647\u0627
      \u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u064A.
      \u062D\u0638\u0627\u064B \u0645\u0648\u0641\u0642\u0627\u064B\u060C \u0648\u0627\u0633\u062A\u0645\u062A\u0639!"
    m_Metadata:
      m_Items: []
