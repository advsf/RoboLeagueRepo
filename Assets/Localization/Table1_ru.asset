      \u043D\u0430\u0436\u0430\u0432 \u043A\u043D\u043E\u043F\u043A\u0443 \xABR\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769223
    m_Localized: "\u0418\u0433\u0440\u0430\u044F \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u0438
      \u043F\u043E\u043B\u0443\u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430
      (LMF/RMF), \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \xAB\u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\xBB
      \u043C\u044F\u0447 \u0438\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
      \u0435\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u0414\u043B\u044F
      \u044D\u0442\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      \u043A \u043C\u044F\u0447\u0443 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C. \u041F\u043E\u043B\u0435\u0437\u043D\u043E
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0430 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
      \u043F\u0430\u0441\u043E\u0432 \u0438\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u043E
      \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0445\u0441\u044F \u043C\u044F\u0447\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769224
    m_Localized: "\u0412\u0430\u0448\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u043F\u043E\u043B\u0443\u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0430\u043C \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u0431\u0440\u043E\u0441\u043E\u043A \u0440\u0443\u043B\u0435\u0442\u043A\u0438
      \u0438\u043B\u0438 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0443\u0432\u043B\u0435\u043A\u0430\u0435\u0442 \u0437\u0430 \u0441\u043E\u0431\u043E\u0439
      \u043C\u044F\u0447. \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
      \u044D\u0442\u043E\u0433\u043E \u0431\u0440\u043E\u0441\u043A\u0430 \u0442\u0430\u043A\u0436\u0435
      \u0434\u0430\u0435\u0442 \u0432\u0430\u043C \u043D\u0435\u0431\u043E\u043B\u044C\u043A\u043E\u0435
      \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435. \u0427\u0442\u043E\u0431\u044B
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E,
      \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u0438\u0433\u0440\u043E\u043A\u043E\u043C,
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0449\u0438\u043C \u0431\u0440\u043E\u0441\u043E\u043A,
      \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0431\u043B\u0438\u0437\u043A\u043E \u043A \u043C\u044F\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769225
    m_Localized: "\u0412 \u0440\u043E\u043B\u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430
      (CB) \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u0434\u0432\u0443\u043C \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C
      \u043F\u0440\u0438\u0435\u043C\u0430\u043C. \u041F\u0435\u0440\u0432\u044B\u0439
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \xAB\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E\xBB,
      \u0438 \u0434\u043B\u044F \u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043D\u0430\u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u044C
      \u0435\u0433\u043E. \u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
      \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769226
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0432\u0430\u0448\u0430
      \u0437\u0430\u0449\u0438\u0442\u043D\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \xAB\u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435\xBB
      \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C
      \u043C\u044F\u0447\u0438 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435.
      \u042D\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0434\u043B\u044F \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u043F\u0435\u0440\u0435\u0434\u0430\u0447
      \u0438\u043B\u0438 \u0443\u0434\u0430\u0440\u043E\u0432. \u041E\u0447\u0435\u043D\u044C
      \u043C\u043E\u0449\u043D\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0435\u0451 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769227
    m_Localized: "\u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0432\u0440\u0430\u0442\u0430\u0440\u044F
      \u0443 \u0432\u0430\u0441 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439. \u041E\u0434\u043D\u0430\u043A\u043E
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u044B\u0440\u044F\u0442\u044C
      \u0438 \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C \u043C\u044F\u0447
      \u043F\u0440\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0435. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \"D\", \u0447\u0442\u043E\u0431\u044B
      \u043D\u044B\u0440\u043D\u0443\u0442\u044C \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0432\u0430\u0448\u0435\u0433\u043E
      \u0438\u0433\u0440\u043E\u043A\u0430, \u0438 \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u043D\u0438\u0442\u0435
      \u043F\u0435\u0440\u0435\u0434 \u043D\u044B\u0440\u043A\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769228
    m_Localized: "\u0422\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0436\u0430\u0442\u044C
      \u043A\u043D\u043E\u043F\u043A\u0443 \xABC\xBB, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u043C\u044F\u0447, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u0437\u0435\u043C\u043B\u0435. \u042D\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E
      \u0434\u043B\u044F \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u043F\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u044F
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769229
    m_Localized: "\u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u044F\u0447
      \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0443 \u0432\u0430\u0441
      \u0432 \u0440\u0443\u043A\u0430\u0445, \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C
      \u0434\u0432\u0430 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430: \u0443\u0434\u0430\u0440
      \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C \u043E\u0442 \u0437\u0435\u043C\u043B\u0438
      \u0438\u043B\u0438 \u043F\u0430\u0441 \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C.
      \u0414\u043B\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      \u0443\u0434\u0430\u0440\u0430 \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C
      \u043E\u0442 \u0437\u0435\u043C\u043B\u0438 \u0432\u0430\u043C \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043E\u0431\u044B\u0447\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440 (\u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A
      \u0441 \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \xABS\xBB). \u0423\u0434\u0430\u0440\u044B
      \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C \u043E\u0442 \u0437\u0435\u043C\u043B\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435
      \u0438 \u0432\u044B\u0448\u0435, \u0447\u0435\u043C \u043F\u0430\u0441 \u0441
      \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769230
    m_Localized: "\u0414\u043B\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      \u043F\u0430\u0441\u0430 \u0432 \u043F\u0440\u044B\u0436\u043A\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043C\u044F\u0447 \u0432 \u0440\u0443\u043A\u0430\u0445.
      \u0417\u0430\u0442\u0435\u043C \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435
      \u0431\u0440\u043E\u0441\u043E\u043A \u0441 \u0434\u0440\u0438\u0431\u043B\u0438\u043D\u0433\u043E\u043C.
      \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439, \u043D\u043E \u0431\u043E\u043B\u0435\u0435
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439
      \u043F\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875429769231
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C
      \u0441 \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u043C \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F! \u0422\u0435\u043F\u0435\u0440\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u043E\u0441\u0432\u043E\u0438\u043B\u0438
      \u043E\u0441\u043D\u043E\u0432\u044B, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043B\u0438\u0431\u043E \u0441\u044B\u0433\u0440\u0430\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439
      \u043E\u043D\u043B\u0430\u0439\u043D-\u043C\u0430\u0442\u0447 \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
      \u0438\u0433\u0440\u043E\u043A\u0430\u043C\u0438, \u043B\u0438\u0431\u043E
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u043D\u0430\u0432\u044B\u043A\u0438, \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0432\u0448\u0438\u0441\u044C
      \u043A \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u043C\u0443
      \u0441\u0435\u0440\u0432\u0435\u0440\u0443. \u0412 \u044D\u0442\u043E\u043C
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0435 \u043D\u0435
      \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u043F\u0440\u0438\u0435\u043C\u043E\u0432
      \u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445 \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u0432.
      \u0423\u0434\u0430\u0447\u0438 \u0438 \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0439
      \u0438\u0433\u0440\u044B!"
    m_Metadata:
      m_Items: []
