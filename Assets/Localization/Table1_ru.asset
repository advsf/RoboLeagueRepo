  - m_Id: 1162875429769221
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u0437\u0438\u0446\u0438\u044F
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0434\u0432\u0443\u043C\u044F
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438.
      \u041D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 \u043F\u043E\u0437\u0438\u0446\u0438\u0438
      cf, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C powerkick
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C
      \u0443\u0434\u0430\u0440\u044B \u0441 \u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0441\u0438\u043B\u043E\u0439, \u043F\u0440\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0438,
      \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0435 \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430\u0436\u0430\u0442\u0438\u044F \u043D\u0430 \u0448\u043A\u0430\u043B\u0443
      \u0443\u0434\u0430\u0440\u0430. \u0414\u043B\u044F \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043A\u043D\u043E\u043F\u043A\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u0448\u043A\u0430\u043B\u0430 \u043A\u043E\u0441\u043D\u0435\u0442\u0441\u044F
      \u0431\u0435\u043B\u043E\u0439 \u0447\u0430\u0441\u0442\u0438. \u0410\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0435\u0451 \u043C\u043E\u0436\u043D\u043E, \u0434\u0432\u0430\u0436\u0434\u044B
      \u043D\u0430\u0436\u0430\u0432 \u043A\u043D\u043E\u043F\u043A\u0443 \"L\"."
