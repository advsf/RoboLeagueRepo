      \u043F\u0440\u0438\u0434\u0430\u0432\u0430\u0442\u044C \u0435\u043C\u0443 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435.
      \u041A\u0430\u043A \u0438 \u043F\u0440\u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u0438
      \u043C\u044F\u0447\u0430, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A\u0430
      \u0431\u0443\u0434\u0435\u0442 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0442\u044C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F.
      \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u0443\u0434\u0430\u0440\u044B
      \u0441 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u0443\u0434\u0430\u0440\u044B \u0431\u0435\u0437 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F."
