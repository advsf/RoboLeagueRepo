  - m_Id: 1156324417654784
    m_Localized: "\u0412\u0412\u0415\u0414\u0418\u0422\u0415 \u0422\u0415\u041A\u0421\u0422..."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875371048960
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u044D\u0442\u043E\u0442 \u043E\u0431\u0443\u0447\u0430\u044E\u0449\u0438\u0439
      \u043A\u0443\u0440\u0441! \u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C
      \u044D\u0442\u0430\u043F\u0435 \u0432\u044B \u0438\u0437\u0443\u0447\u0438\u0442\u0435
      \u043E\u0441\u043D\u043E\u0432\u044B \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438
      WASD \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F, \u043B\u0435\u0432\u044B\u0439
      Shift \u0434\u043B\u044F \u0431\u0435\u0433\u0430, \u043F\u0440\u043E\u0431\u0435\u043B
      \u0434\u043B\u044F \u043F\u0440\u044B\u0436\u043A\u0430, \u043B\u0435\u0432\u044B\u0439
      Control \u0434\u043B\u044F \u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u044F
      \u0438 \u043A\u043B\u0430\u0432\u0438\u0448\u0443 E \u0434\u043B\u044F \u0440\u044B\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574912
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0434\u0430\u0442\u044C
      \u043C\u044F\u0447\u0443 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0441\u0438\u043B\u0443, \u0441\u043A\u043E\u043B\u044C\u0437\u044F \u043F\u043E
      \u043D\u0435\u043C\u0443, \u043D\u0430\u0436\u0430\u0432 \u043B\u0435\u0432\u0443\u044E
      \u043A\u043B\u0430\u0432\u0438\u0448\u0443 Control. \u042D\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E
      \u0434\u043B\u044F \u043E\u0442\u0431\u043E\u0440\u0430 \u043C\u044F\u0447\u0430
      \u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u0438\u043B\u0438
      \u0434\u043B\u044F \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043D\u0438\u0437\u043A\u043E\u0433\u043E
      \u0443\u0434\u0430\u0440\u0430. \u0422\u0435\u043F\u0435\u0440\u044C \u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0438\u0442\u0435
      \u043C\u044F\u0447\u043E\u043C \u0432 \u043E\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574913
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u0432\u044B \u043D\u0430\u0443\u0447\u0438\u0442\u0435\u0441\u044C
      \u0432\u0435\u0441\u0442\u0438 \u043C\u044F\u0447. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043F\u0440\u0430\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u0444\u0438\u043D\u0442, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043C\u044F\u0447 \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0437\u0430 \u0432\u0430\u0448\u0438\u043C \u0438\u0433\u0440\u043E\u043A\u043E\u043C.
      \u042D\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E \u0434\u043B\u044F
      \u043F\u0440\u043E\u0440\u044B\u0432\u0430 \u043E\u0431\u043E\u0440\u043E\u043D\u044B
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574914
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043D\u0430\u0443\u0447\u0438\u0442\u0435\u0441\u044C
      \u0431\u0438\u0442\u044C \u043F\u043E \u043C\u044F\u0447\u0443. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0440\u044F\u0434\u0438\u0442\u044C
      \u0443\u0434\u0430\u0440. \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u0432\u044B\u0441\u043E\u0442\u0443
      \u0443\u0434\u0430\u0440\u0430, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0432
      \u0432\u0432\u0435\u0440\u0445 \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C,
      \u043A\u0430\u043A \u0443\u0434\u0430\u0440\u0438\u0442\u044C \u043F\u043E
      \u043C\u044F\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574915
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435, \u043A\u0430\u043A \u0431\u0438\u0442\u044C
      \u043F\u043E \u043C\u044F\u0447\u0443, \u0432\u044B \u043D\u0430\u0443\u0447\u0438\u0442\u0435\u0441\u044C
      \u043F\u0440\u0438\u0434\u0430\u0432\u0430\u0442\u044C \u0435\u043C\u0443 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0441\u043B\u0435\u0433\u043A\u0430 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
      \u043C\u044F\u0447\u0430 \u043C\u044B\u0448\u044C\u044E \u043F\u0435\u0440\u0435\u0434
      \u0443\u0434\u0430\u0440\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u043E\u043D
      \u0437\u0430\u043A\u0440\u0443\u0442\u0438\u043B\u0441\u044F \u0432 \u043D\u0443\u0436\u043D\u043E\u043C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438. \u0423\u0434\u0430\u0440\u044B
      \u0441 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u0443\u0434\u0430\u0440\u044B \u0431\u0435\u0437 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574916
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u0437\u0438\u0446\u0438\u044F
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0434\u0432\u0443\u043C\u044F
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      (\u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u043F\u043E\u043B\u0443\u0437\u0430\u0449\u0438\u0442\u044B). \u041D\u0430\u0447\u0438\u043D\u0430\u044F
      \u0441 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0449\u0435\u0433\u043E, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \xAB\u043C\u043E\u0449\u043D\u044B\u0439 \u0443\u0434\u0430\u0440\xBB \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C \u0443\u0434\u0430\u0440\u044B
      \u0441 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0441\u0438\u043B\u043E\u0439,
      \u043F\u0440\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0438, \u0447\u0442\u043E
      \u0432\u044B \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0435
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0443\u0434\u0430\u0440\u0430. \u0414\u043B\u044F
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043A\u043D\u043E\u043F\u043A\u0443, \u043A\u043E\u0433\u0434\u0430 \u043F\u043B\u0430\u043D\u043A\u0430
      \u043A\u043E\u0441\u043D\u0435\u0442\u0441\u044F \u0431\u0435\u043B\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574917
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      CF, \xAB\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u043D\u0438\u043A\xBB, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u042D\u0442\u043E \u043C\u043E\u0436\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0434\u043B\u044F
      \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u0440\u043E\u0440\u044B\u0432\u0430
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u043E\u0440\u043E\u043D\u0443 \u0438
      \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0433\u043E\u043B\u0435\u0432\u044B\u0445
      \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574918
    m_Localized: "\u0418\u0433\u0440\u0430\u044F \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u0438
      \u043F\u043E\u043B\u0443\u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430
      (LMF/RMF), \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \xAB\u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\xBB
      \u043C\u044F\u0447 \u0438\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
      \u0435\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u0414\u043B\u044F
      \u044D\u0442\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      \u043A \u043C\u044F\u0447\u0443 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C. \u041F\u043E\u043B\u0435\u0437\u043D\u043E
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0430 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
      \u043F\u0430\u0441\u043E\u0432 \u0438\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u043E
      \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0445\u0441\u044F \u043C\u044F\u0447\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574919
    m_Localized: "\u0412\u0430\u0448\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u043F\u043E\u043B\u0443\u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0430\u043C \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u0431\u0440\u043E\u0441\u043E\u043A \u0440\u0443\u043B\u0435\u0442\u043A\u0438
      \u0438\u043B\u0438 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0443\u0432\u043B\u0435\u043A\u0430\u0435\u0442 \u0437\u0430 \u0441\u043E\u0431\u043E\u0439
      \u043C\u044F\u0447. \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
      \u044D\u0442\u043E\u0433\u043E \u0431\u0440\u043E\u0441\u043A\u0430 \u0442\u0430\u043A\u0436\u0435
      \u0434\u0430\u0435\u0442 \u0432\u0430\u043C \u043D\u0435\u0431\u043E\u043B\u044C\u043A\u043E\u0435
      \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435. \u0427\u0442\u043E\u0431\u044B
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E,
      \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u0438\u0433\u0440\u043E\u043A\u043E\u043C,
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0449\u0438\u043C \u0431\u0440\u043E\u0441\u043E\u043A,
      \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0431\u043B\u0438\u0437\u043A\u043E \u043A \u043C\u044F\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574920
    m_Localized: "\u0412 \u0440\u043E\u043B\u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430
      (CB) \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u0434\u0432\u0443\u043C \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C
      \u043F\u0440\u0438\u0435\u043C\u0430\u043C. \u041F\u0435\u0440\u0432\u044B\u0439
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \xAB\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E\xBB,
      \u0438 \u0434\u043B\u044F \u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043D\u0430\u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u044C
      \u0435\u0433\u043E. \u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
      \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574921
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0432\u0430\u0448\u0430
      \u0437\u0430\u0449\u0438\u0442\u043D\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \xAB\u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435\xBB
      \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C
      \u043C\u044F\u0447\u0438 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435.
      \u042D\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0434\u043B\u044F \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u043F\u0435\u0440\u0435\u0434\u0430\u0447
      \u0438\u043B\u0438 \u0443\u0434\u0430\u0440\u043E\u0432. \u041E\u0447\u0435\u043D\u044C
      \u043C\u043E\u0449\u043D\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0435\u0451 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574922
    m_Localized: "\u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0432\u0440\u0430\u0442\u0430\u0440\u044F
      \u0443 \u0432\u0430\u0441 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439. \u041E\u0434\u043D\u0430\u043A\u043E
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u044B\u0440\u044F\u0442\u044C
      \u0438 \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C \u043C\u044F\u0447
      \u043F\u0440\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0435. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      Q, \u0447\u0442\u043E\u0431\u044B \u043D\u044B\u0440\u043D\u0443\u0442\u044C
      \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u0432\u0430\u0448\u0435\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430,
      \u0438 \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u043D\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043D\u044B\u0440\u043A\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E \u0432
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574923
    m_Localized: "\u0422\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0436\u0430\u0442\u044C
      \u043A\u043B\u0430\u0432\u0438\u0448\u0443 T, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u043C\u044F\u0447, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u0437\u0435\u043C\u043B\u0435. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u043D\u0430\u0434 \u043C\u044F\u0447\u043E\u043C. \u042D\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E
      \u0434\u043B\u044F \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u0430\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574924
    m_Localized: "\u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u044F\u0447
      \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0443 \u0432\u0430\u0441
      \u0432 \u0440\u0443\u043A\u0430\u0445, \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C
      \u0434\u0432\u0430 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430: \u0443\u0434\u0430\u0440\u0438\u0442\u044C
      \u043F\u043E \u043C\u044F\u0447\u0443 \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C
      \u0438\u043B\u0438 \u043E\u0442\u043A\u0430\u0442\u0438\u0442\u044C \u043C\u044F\u0447.
      \u0414\u043B\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      \u0443\u0434\u0430\u0440\u0430 \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043B\u0435\u0432\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0434\u043B\u044F
      \u0435\u0433\u043E \u0437\u0430\u0440\u044F\u0434\u043A\u0438 \u2014 \u0442\u0430\u043A
      \u0436\u0435, \u043A\u0430\u043A \u0438 \u0434\u043B\u044F \u0437\u0430\u0440\u044F\u0434\u043A\u0438
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430.
      \u0423\u0434\u0430\u0440\u044B \u0441 \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u043C
      \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435
      \u0438 \u0432\u044B\u0448\u0435, \u0447\u0435\u043C \u043F\u0430\u0441\u044B
      \u0441 \u043E\u0442\u043A\u0430\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1162875425574925
    m_Localized: "\u0414\u043B\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      \u043F\u0430\u0441\u0430 \u0432 \u043F\u0440\u044B\u0436\u043A\u0435 \u0432\u0430\u043C
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043C\u044F\u0447 \u0432 \u0440\u0443\u043A\u0430\u0445. \u0417\u0430\u0442\u0435\u043C
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043F\u0440\u0430\u0432\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 (\u043A\u0430\u043A
      \u043F\u0440\u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043C\u044F\u0447\u0430),
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u043F\u0430\u0441 \u0432 \u043F\u0440\u044B\u0436\u043A\u0435, \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0433\u043E \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0434\u0430\u0442\u044C
      \u043C\u044F\u0447. \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442
      \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439,
      \u043D\u043E \u0431\u043E\u043B\u0435\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439
      \u043F\u0430\u0441."
